# Application
APP_NAME=freight-quote-api

# Database
DATABASE_URL=postgresql+psycopg2://freight:freight@db:5432/freight

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Freight pricing parameters
FREIGHT_BASE_PRICE=20.0
FREIGHT_PRICE_PER_KG=1.5
FREIGHT_PRICE_PER_M3=8.0
FREIGHT_DISTANCE_FACTOR=0.5

# Postgres container (used by docker-compose)
POSTGRES_USER=freight
POSTGRES_PASSWORD=freight
POSTGRES_DB=freight
